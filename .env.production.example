# Copy to .env.production on the EC2 instance. Do not commit the copied file.
POSTGRES_DB=ai_sandbox_db
POSTGRES_USER=sandbox_user
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Required: generate a long random value and send it via X-API-Key.
SANDBOX_API_KEY=replace-with-a-long-random-api-key

# Required for the non-root API container to reach the host Docker socket.
# On Ubuntu EC2: stat -c '%g' /var/run/docker.sock
DOCKER_GID=replace-with-numeric-socket-group-id

# Set these only when using POST /api/v1/agent/run.
SANDBOX_LLM_PROVIDER=gemini
SANDBOX_LLM_API_KEY=replace-with-llm-api-key
SANDBOX_LLM_MODEL=gemini-2.5-flash
