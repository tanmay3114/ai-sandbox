# Copy this file to .env and replace the local password.
# Never commit .env.

# PostgreSQL container configuration
POSTGRES_DB=ai_sandbox_db
POSTGRES_USER=sandbox_user
POSTGRES_PASSWORD=change_me

# Application / Alembic database connection
SANDBOX_DATABASE_URL=postgresql://sandbox_user:change_me@localhost:5433/ai_sandbox_db

# LLM Provider configuration (Google Gemini by default)
SANDBOX_LLM_PROVIDER=gemini
SANDBOX_LLM_API_KEY=your-gemini-api-key-here
SANDBOX_LLM_MODEL=gemini-2.5-flash
# SANDBOX_LLM_TEMPERATURE=0.0

# Optional OpenAI configuration
# SANDBOX_LLM_PROVIDER=openai
# SANDBOX_LLM_API_KEY=your-openai-api-key-here
# SANDBOX_LLM_MODEL=gpt-4o-mini
# SANDBOX_LLM_BASE_URL=https://api.openai.com/v1

# Agent Loop configuration
# SANDBOX_AGENT_MAX_ITERATIONS=10
# SANDBOX_AGENT_REQUEST_TIMEOUT=60.0

